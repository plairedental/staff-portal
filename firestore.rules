rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(myPath()).data; }
    function active() { return signedIn() && exists(myPath()) && me().status == 'active' && me().get('work', '재직') != '퇴사'; }
    function hasRole(r) { return active() && me().role in r; }
    function isAdmin() { return hasRole(['admin']); }

    // 직원 기본정보 (급여는 여기 없음)
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || hasRole(['doctor', 'chief'])
        || (hasRole(['leader']) && resource.data.team == me().team)
      );
      // 가입: 본인 문서만, 항상 '직원 / 승인 대기'로 시작 (관리자는 가입 전 명부를 미리 만들 수 있음)
      allow create: if isAdmin() || signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'staff'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'status', 'createdAt']);
      // 관리자는 모두 수정, 본인은 연락처·글씨 크기만
      allow update: if isAdmin()
        || (request.auth.uid == uid && active()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'fontSize']));
      allow delete: if isAdmin();
    }

    // 급여: 본인과 관리자만
    match /salaries/{uid} {
      allow read: if isAdmin() || (request.auth.uid == uid && active());
      allow write: if isAdmin();
    }

    // 화면 설정(app)은 로그인 화면에서도 보여야 해서 누구나 읽기, 나머지(연차 규칙 등)는 승인된 직원만. 수정은 관리자만
    match /settings/{id} {
      allow read: if id == 'app' || active();
      allow write: if isAdmin();
    }

    // 연차 신청: 본인·승인자(관리자, 총괄실장)·같은 팀 팀장만 보기
    match /leaves/{id} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid
        || hasRole(['admin', 'chief'])
        || (hasRole(['leader']) && resource.data.team == me().team)
      );
      allow create: if hasRole(['admin', 'chief'])
        || (active() && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == '대기'
            && request.resource.data.team == me().get('team', ''));
      allow update: if hasRole(['admin', 'chief']);
      allow delete: if hasRole(['admin', 'chief'])
        || (active() && resource.data.uid == request.auth.uid && resource.data.status == '대기');
    }

    // 휴가 증빙서류: 본인과 관리자·총괄실장만 (진단서 등 민감 정보)
    match /leaveFiles/{fid} {
      allow read, delete: if active() && (resource.data.uid == request.auth.uid || hasRole(['admin', 'chief']));
      allow create: if active() && (request.resource.data.uid == request.auth.uid || hasRole(['admin', 'chief']));
      allow update: if hasRole(['admin', 'chief']);
      match /chunks/{n} {
        allow read, create, delete: if active() && (
          get(/databases/$(database)/documents/leaveFiles/$(fid)).data.uid == request.auth.uid || hasRole(['admin', 'chief']));
      }
    }

    // 근무표: 승인된 직원 모두 보기, 관리자·총괄실장 수정
    match /schedules/{month} {
      allow read: if active();
      allow write: if hasRole(['admin', 'chief']);
    }

    // 월별 급여표: 관리자만
    match /payroll/{month} {
      allow read, write: if isAdmin();
    }

    // 급여명세서: 본인과 관리자만
    match /payslips/{id} {
      allow read: if isAdmin() || (active() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // 조직도: 승인된 직원 모두 보기, 관리자·총괄실장 수정
    match /org/{id} {
      allow read: if active();
      allow write: if hasRole(['admin', 'chief']);
    }

    // 매뉴얼: 승인된 직원 모두 읽기, 관리자·총괄실장 수정
    match /manuals/{id} {
      allow read: if active();
      allow write: if hasRole(['admin', 'chief']);
    }
    // 서류 신청: 본인과 관리자만. 직원은 '신청' 상태로만 만들고, 처리는 관리자
    // 일계표(환자 수납 기록 포함): 관리자만
    match /daily/{id} {
      allow read, write: if isAdmin();
    }
    // 목표매출·인센티브 설정: 관리자만
    match /incentive/{id} {
      allow read, write: if isAdmin();
    }
    match /docReqs/{id} {
      allow read: if isAdmin() || (active() && resource.data.uid == request.auth.uid);
      allow create: if active() && request.resource.data.uid == request.auth.uid && request.resource.data.status == '신청';
      allow update: if isAdmin();
      allow delete: if isAdmin() || (active() && resource.data.uid == request.auth.uid && resource.data.status == '신청');
    }
    match /manualMeta/{id} {
      allow read: if active();
      allow write: if hasRole(['admin', 'chief']);
    }
    match /manualImages/{id} {
      allow read: if active();
      allow write: if hasRole(['admin', 'chief']);
    }
    // 업데이트 기록·AI 제안: 모두 보기, 관리자·총괄실장만 쓰기
    match /manualLog/{id} {
      allow read: if active();
      allow write: if hasRole(['admin', 'chief']);
    }
    // 직원 성찰노트·개선 요청: 모두 보기, 본인 글 쓰기, 피드백·상태는 관리자·총괄실장
    match /notes/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.uid == request.auth.uid;
      allow update: if hasRole(['admin', 'chief'])
        || (active() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mistake', 'plan', 'pageId', 'pageTitle']));
      allow delete: if hasRole(['admin', 'chief']) || (active() && resource.data.uid == request.auth.uid);
    }
    match /manualReqs/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.uid == request.auth.uid;
      allow update: if hasRole(['admin', 'chief'])
        || (active() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'pageId', 'pageTitle']));
      allow delete: if hasRole(['admin', 'chief']) || (active() && resource.data.uid == request.auth.uid);
    }
  }
}
